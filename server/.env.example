# انسخ هذا الملف باسم .env في نفس المجلد ثم ضع مفتاحك.
# لا ترفع ملف .env إلى GitHub ولا تضع المفاتيح في script.js أبداً.

# مزوّد تفريغ الكلام: groq (الأرخص ويوجد استخدام مجاني محدود) | openai | local (مجاني على جهازك) | none
STT_PROVIDER=groq

# Groq: أنشئ مفتاحاً من https://console.groq.com/keys
GROQ_API_KEY=
# whisper-large-v3 (أدق للعربية) أو whisper-large-v3-turbo (أسرع وأرخص)
GROQ_MODEL=whisper-large-v3

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=whisper-1

# للتفريغ المحلي: tiny | base | small | medium | large-v3  (الأكبر أدق وأبطأ)
LOCAL_WHISPER_MODEL=small

# الحدود
MAX_UPLOAD_MB=200
MAX_DURATION_MIN=90
PORT=5000

# 127.0.0.1 = هذا الحاسوب فقط | 0.0.0.0 = فتح الموقع من الهاتف على نفس شبكة الواي فاي
HOST=127.0.0.1

# نفق Cloudflare لتعمل روابط الفيديو من صفحة GitHub عبر الإنترنت (يحتاج server/bin/cloudflared.exe)
TUNNEL=0
# عنوان صفحتك على GitHub Pages
PUBLIC_SITE_URL=https://yahiabalash.github.io/Yahia_Caption/
